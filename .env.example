# Copy this file to .env (local dev) or .env.prod (Docker production).
# Never commit either of those files — they contain secrets.

# ── Supabase (hosted) ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # worker needs this to bypass RLS; never expose to clients
SUPABASE_STORAGE_BUCKET=vendi-datasets

# JWT verification — use ONE of the two options below:
#   Option A (recommended): JWKS URL — validates RS256 tokens from Supabase Auth
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
#   Option B: shared secret — validates HS256 tokens (older Supabase projects)
SUPABASE_JWT_SECRET=

# ── Job queue ─────────────────────────────────────────────────────────────────
# Local dev:    redis://localhost:6379/0
# Docker:       redis://redis:6379/0   (set automatically by docker-compose.yml)
# Managed Redis: rediss://:<password>@host:6380/0
REDIS_URL=redis://localhost:6379/0

# ── Upload / validation limits ────────────────────────────────────────────────
MAX_UPLOAD_MB=100
MIN_DATE_SPAN_WEEKS=8
MIN_TRANSACTIONS=200

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API.
# Local dev:    http://localhost:3000
# Production:   https://your-frontend-domain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Environment ───────────────────────────────────────────────────────────────
# dev | prod  — controls log format (pretty vs JSON) and other guards
ENV=dev

# ── Async jobs ────────────────────────────────────────────────────────────────
# false (default) — ML jobs are queued to Redis and run in the ARQ worker.
# true            — ML jobs run synchronously in the API process.
#                   Local smoke-testing only; NEVER use in production.
SYNC_JOBS=false

# ── API server (Docker only) ──────────────────────────────────────────────────
# Number of gunicorn worker processes. Defaults to 2 if unset.
# Rule of thumb: (2 × CPU count) + 1
WEB_CONCURRENCY=2
